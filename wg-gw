#!/bin/sh
# Bring up every wgt_*.conf in $CONF_DIR with wg-quick (node netns, hostNetwork),
# add forwarding/MSS-clamp rules, then wait. Tear everything down on SIGTERM.
# Re-running is safe: leftovers from a previous run are removed first.
set -eu

CONF_DIR=${CONF_DIR:-/etc/wg-gw}
TAG=wg-gw

log() { echo "wg-gw: $*"; }

ipt() { # ipt <table> <chain> <rule...>: add once
	t=$1 c=$2; shift 2
	iptables -t "$t" -C "$c" -m comment --comment "$TAG" "$@" 2>/dev/null ||
		iptables -t "$t" -I "$c" 1 -m comment --comment "$TAG" "$@"
}

ip6t() { # same for IPv6
	t=$1 c=$2; shift 2
	ip6tables -t "$t" -C "$c" -m comment --comment "$TAG" "$@" 2>/dev/null ||
		ip6tables -t "$t" -I "$c" 1 -m comment --comment "$TAG" "$@"
}

# Optional: keep the tunnel sockets talking only to EGRESS_ALLOW destinations
# (e.g. a UDP proxy in front of them). Anything else sent from a ListenPort is
# dropped, so peers never see (and roam to) another source address.
egress_up() {
	[ -n "${EGRESS_ALLOW:-}" ] || return 0
	ports=$(wg show all listen-port | awk '{print $2}' | paste -sd, -)
	[ -n "$ports" ] || return 0
	# ipt inserts at the top: DROP first, then the ACCEPTs above it.
	ipt filter OUTPUT -p udp -m multiport --sports "$ports" -j DROP
	ip6t filter OUTPUT -p udp -m multiport --sports "$ports" -j DROP
	for d in $(echo "$EGRESS_ALLOW" | tr ',' ' '); do
		case $d in
			*:*) ip6t filter OUTPUT -p udp -m multiport --sports "$ports" -d "$d" -j ACCEPT ;;
			*) ipt filter OUTPUT -p udp -m multiport --sports "$ports" -d "$d" -j ACCEPT ;;
		esac
	done
}

rules_up() {
	ipt filter FORWARD -i wgt+ -j ACCEPT
	ipt filter FORWARD -o wgt+ -j ACCEPT
	ipt mangle FORWARD -o wgt+ -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
	ipt mangle OUTPUT -o wgt+ -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
	# Optional: rewrite the source of traffic leaving through the tunnels
	# (e.g. pod CIDR, or tunnel addresses picked for locally originated packets).
	# Tunnel-to-tunnel traffic (BGP sessions) is left alone.
	if [ -n "${SNAT_TO:-}" ]; then
		for s in $(echo "${SNAT_SOURCES:-}" | tr ',' ' '); do
			ipt nat POSTROUTING -o wgt+ -s "$s" ! -d 169.254.0.0/16 -j SNAT --to-source "$SNAT_TO"
		done
	fi
}

rules_down() {
	for t in filter mangle nat; do
		iptables -t "$t" -S | grep -- "--comment $TAG" | sed 's/^-A /-D /' |
			while read -r r; do eval iptables -t "$t" "$r" || true; done
	done
	ip6tables -t filter -S | grep -- "--comment $TAG" | sed 's/^-A /-D /' |
		while read -r r; do eval ip6tables -t filter "$r" || true; done
}

links_down() {
	for l in $(ip -o link show type wireguard | awk -F': ' '{print $2}' | cut -d@ -f1); do
		case $l in wgt_*) ip link del "$l" && log "removed $l" ;; esac
	done
}

down() {
	links_down
	rules_down
}

up() {
	set -- "$CONF_DIR"/wgt_*.conf
	[ -e "$1" ] || { log "no wgt_*.conf in $CONF_DIR"; exit 1; }
	for c; do
		wg-quick up "$c"
	done
	rules_up
	egress_up
	log "up: $(wg show interfaces)"
}

case ${1:-run} in
	run)
		down
		up
		trap 'down; exit 0' TERM INT
		while :; do sleep 3600 & wait $!; done
		;;
	down) down ;;
	*) echo "usage: wg-gw [run|down]" >&2; exit 2 ;;
esac
